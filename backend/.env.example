# POST /api/auth/bootstrap-admin. Set it back to false immediately afterward.
ENABLE_ADMIN_BOOTSTRAP=false
STEADFAST_BASE_URL=https://portal.packzy.com/api/v1
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
STEADFAST_WEBHOOK_TOKEN=replace-with-a-random-webhook-secret
